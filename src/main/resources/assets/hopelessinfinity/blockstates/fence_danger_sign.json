{
 "multipart": [
  {
   "apply": {
    "model": "hopelessinfinity:block/fence_danger_sign_post_ends"
   }
  },
  {
   "apply": {
    "model": "hopelessinfinity:block/fence_danger_sign_post"
   },
   "when": {
    "east": "false",
    "north": "false",
    "south": "false",
    "west": "false"
   }
  },
  {
   "apply": {
    "model": "hopelessinfinity:block/fence_danger_sign_cap"
   },
   "when": {
    "east": "false",
    "north": "true",
    "south": "false",
    "west": "false"
   }
  },
  {
   "apply": {
    "model": "hopelessinfinity:block/fence_danger_sign_cap",
    "y": 90
   },
   "when": {
    "east": "true",
    "north": "false",
    "south": "false",
    "west": "false"
   }
  },
  {
   "apply": {
    "model": "hopelessinfinity:block/fence_danger_sign_cap_alt"
   },
   "when": {
    "east": "false",
    "north": "false",
    "south": "true",
    "west": "false"
   }
  },
  {
   "apply": {
    "model": "hopelessinfinity:block/fence_danger_sign_cap_alt",
    "y": 90
   },
   "when": {
    "east": "false",
    "north": "false",
    "south": "false",
    "west": "true"
   }
  },
  {
   "apply": {
    "model": "hopelessinfinity:block/fence_danger_sign_side"
   },
   "when": {
    "north": "true"
   }
  },
  {
   "apply": {
    "model": "hopelessinfinity:block/fence_danger_sign_side",
    "y": 90
   },
   "when": {
    "east": "true"
   }
  },
  {
   "apply": {
    "model": "hopelessinfinity:block/fence_danger_sign_side_alt"
   },
   "when": {
    "south": "true"
   }
  },
  {
   "apply": {
    "model": "hopelessinfinity:block/fence_danger_sign_side_alt",
    "y": 90
   },
   "when": {
    "west": "true"
   }
  },
  {
   "when": {
    "OR": [
     {
      "east": "true"
     },
     {
      "west": "true"
     }
    ]
   },
   "apply": {
    "model": "hopelessinfinity:block/fence_danger_sign_plate"
   }
  },
  {
   "when": {
    "OR": [
     {
      "north": "true"
     },
     {
      "south": "true"
     }
    ]
   },
   "apply": {
    "model": "hopelessinfinity:block/fence_danger_sign_plate",
    "y": 90
   }
  }
 ]
}
